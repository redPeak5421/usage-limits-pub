    "widget.gallery.mediumDetail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show every allowance level and reset time for the selected account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche tous les plafonds et réinitialisations du compte choisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したアカウントの全枠とリセット時刻を表示します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все лимиты и время сброса выбранного аккаунта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展示所选账号的全部限额级别与重置时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示所選帳號的全部限額級別與重置時間"
          }
        }
      }
    },
