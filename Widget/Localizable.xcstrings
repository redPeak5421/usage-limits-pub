    "widget.gallery.singleDetail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ring progress for one account’s allowance and reset time. Add another widget for a second account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anneau de progression pour le quota et la réinitialisation d’un compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したアカウントの残量とリセットをリングで表示。同じサービスの別アカウントは別ウィジェットです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кольцо прогресса лимита и сброса выбранного аккаунта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环形进度展示所选账号的额度使用与重置时间；同一服务商的多个账号可各放一个小组件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環形進度顯示所選帳號的額度使用與重置時間；同一服務商的多個帳號可各放一個小工具"
          }
        }
      }
    },
    "widget.overviewDescription": {
      "extractionState": "stale",
      "localizations": {
        "en": {
